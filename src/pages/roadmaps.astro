---
import Base from '../layouts/Base.astro';
import { roadmaps } from '../lib/roadmaps';
---
<Base crumbs={[['Roadmaps','/roadmaps/']]} title="Roadmaps" description="Free AI learning roadmaps: Beginner, Builder and Pro. Tick off each step; your progress stays in your own browser.">
  <div class="wrap">
    <header class="ph">
      <h1>Roadmaps</h1>
      <p class="lede">Three stages, one path. Tick each step when you finish it. Your progress is saved only in this browser, never sent anywhere.</p>
      <nav class="jump" aria-label="Stages">{roadmaps.map((r, i) => <a href={`#${r.id}`}>Stage {i + 1}: {r.title}</a>)}</nav>
    </header>
    {roadmaps.map((r, i) => (
      <section class="stage" id={r.id} data-stage={r.id}>
        <div class="sh2">
          <div>
            <p class="faint">Stage {i + 1}</p>
            <h2>{r.title}</h2>
            <p class="muted" style="margin-top:8px;max-width:44ch">{r.goal}</p>
          </div>
          <div class="prog" aria-hidden="true"><div class="pbar"><i></i></div><span class="pct faint">0 of {r.steps.length} done</span></div>
        </div>
        <ol class="steps">
          {r.steps.map((s) => {
            const live = s.lessons.filter((l) => l.live).length;
            return (
              <li>
                <input type="checkbox" id={`rm-${r.id}-${s.id}`} data-key={s.id} />
                <label for={`rm-${r.id}-${s.id}`}>
                  <span class="st">{s.title}</span>
                  <span class="faint">Track {s.trackN}: {s.track}. {s.lessons.length} lessons{live ? `, ${live} free on YouTube now` : ', coming soon'}.</span>
                </label>
                <a class="btn sm" href={`/courses/syllabus/#${s.id}`}>Lessons<span class="sr"> for {s.title}</span></a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
    <p class="faint" style="margin-top:32px"><button class="btn sm" id="reset" type="button">Clear my progress</button></p>
  </div>
</Base>
<script is:inline>
(function(){
  var KEY='aditejus-roadmap-v1',state={};
  try{state=JSON.parse(localStorage.getItem(KEY)||'{}')||{}}catch(e){state={}}
  function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}
  function paint(){document.querySelectorAll('.stage').forEach(function(s){var b=s.querySelectorAll('input'),n=0;b.forEach(function(x){if(x.checked)n++});
    s.querySelector('.pbar i').style.width=(b.length?n/b.length*100:0)+'%';s.querySelector('.pct').textContent=n+' of '+b.length+' done'})}
  document.querySelectorAll('.steps input').forEach(function(x){x.checked=!!state[x.dataset.key];x.addEventListener('change',function(){if(x.checked)state[x.dataset.key]=1;else delete state[x.dataset.key];save();paint()})});
  document.getElementById('reset').onclick=function(){state={};save();document.querySelectorAll('.steps input').forEach(function(x){x.checked=false});paint()};
  paint();
})();
</script>
<style>
  .jump { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  .jump a { text-decoration: none; border: 1px solid var(--line); border-radius: 99px; padding: 8px 16px; font-size: 15px; }
  .jump a:hover { border-color: var(--a2); }
  .stage { padding: 56px 0 16px; border-top: 1px solid var(--line); scroll-margin-top: 16px; }
  .sh2 { display: flex; justify-content: space-between; gap: 32px; align-items: end; flex-wrap: wrap; margin-bottom: 24px; }
  .prog { min-width: 220px; display: grid; gap: 8px; }
  .pbar { height: 6px; background: var(--line); border-radius: 99px; overflow: hidden; }
  .pbar i { display: block; height: 100%; width: 0; background: var(--grad); transition: width .3s; }
  .steps { list-style: none; padding: 0; counter-reset: s; }
  .steps li { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--line); counter-increment: s; }
  .steps input { width: 22px; height: 22px; accent-color: var(--a2); cursor: pointer; }
  .steps label { display: grid; gap: 2px; cursor: pointer; }
  .steps .st { font-weight: 500; }
  .steps .st::before { content: counter(s) ". "; color: var(--faint); }
  .steps input:checked + label .st { text-decoration: line-through; text-decoration-color: var(--a2); color: var(--muted); }
  @media (max-width: 600px) { .steps li { grid-template-columns: auto 1fr; } .steps .btn { grid-column: 2; justify-self: start; } }
</style>
