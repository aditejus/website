---
import Base from '../layouts/Base.astro';
import Atlas from '../components/Atlas.astro';
import VideoCard from '../components/VideoCard.astro';
import StageCards from '../components/StageCards.astro';
import Newsletter from '../components/Newsletter.astro';
import { stats, latestLive, fmtDate, ytUrl, levelLabel, lessonPath } from '../lib/data';

const live = latestLive();
const feat = live.find((l) => l.youtubeId);
const recent = live.filter((l) => l !== feat).slice(0, 4);
---
<Base title="ADITEJUS" description={`Learn to build real AI: agents, RAG and automation. ${stats.lessons} lessons across ${stats.tracks} tracks, free to start on YouTube, with Udemy certificate courses.`}
  jsonld={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'ADITEJUS', url: 'https://aditejus.com/' }}>
  <div class="wrap">
    <section class="hero">
      <h1>Every lesson you need to build real AI.</h1>
      <div class="row">
        <p class="lede"><strong>{stats.lessons} lessons across {stats.tracks} tracks</strong>, from what an LLM is to training your own. Free on YouTube, with certificate courses on Udemy. Pick a goal and follow the route.</p>
        <div class="ctas"><a class="btn fill" href="/roadmaps/">Plan my route</a><a class="btn" href="/courses/">See every course</a></div>
      </div>
    </section>
    <Atlas />
  </div>

  <div class="wrap">
    {feat && (
      <section class="blk">
        <div class="sh"><h2>New this week.</h2><p>The latest free lesson. No sign-up, nothing to pay.</p></div>
        <VideoCard l={feat} />
        {recent.length > 0 && (
          <ul class="recent">
            {recent.map((l) => <li><a href={lessonPath(l.id)}>{l.title}</a><span class="faint">{levelLabel(l.level)}, {l.minutes} min, {fmtDate(l.publishAt!)}</span></li>)}
          </ul>
        )}
      </section>
    )}

    <section class="blk">
      <div class="sh"><h2>Beginner, builder, pro.</h2><p>One path in three stages. Each stage lists the tracks it draws from; every course page shows what comes before and after.</p></div>
      <StageCards />
    </section>

    <section class="sec">
      <div><h2>The Academy.</h2><p class="aside">A monthly membership for people who want to build alongside us. The basics stay free.</p></div>
      <div>
        <div class="pillars">
          <div><h3>Build-along projects</h3><p>One full project a month, code in the members repo.</p></div>
          <div><h3>Monthly live workshop</h3><p>A practical build and open Q&amp;A.</p></div>
          <div><h3>Project resources</h3><p>Templates, checklists and roadmaps.</p></div>
          <div><h3>Industry insights</h3><p>How companies run AI in production, sourced and dated.</p></div>
          <div><h3>Learning community</h3><p>Show your build, ask for help, keep going.</p></div>
        </div>
        <a class="btn" href="/academy/">How the Academy works</a>
      </div>
    </section>

    <section class="sec">
      <div><h2>Counted, not claimed.</h2></div>
      <div class="nums">
        <div><b>{stats.lessons}</b><span>lessons in the syllabus</span></div>
        <div><b>{stats.live}</b><span>live free on YouTube</span></div>
        <div><b>{stats.udemyLive}</b><span>Udemy courses live</span></div>
        <div><b>{stats.udemyReview}</b><span>Udemy courses in review</span></div>
        <small>From the published curriculum, v{stats.version}, {fmtDate(stats.curriculumDate)}. Recounted every time the site builds. <a href="/courses/syllabus/">See every lesson</a>.</small>
      </div>
    </section>
  </div>
  <Newsletter />
</Base>
<style>
  .hero { padding: clamp(40px, 7vw, 104px) 0 40px; }
  .hero h1 { font-size: clamp(48px, 9.4vw, 148px); max-width: 12ch; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; margin-top: 40px; align-items: end; }
  .row .lede { margin-top: 0; }
  .row .ctas { justify-self: end; margin-top: 0; }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; gap: 8px; } .row .ctas { justify-self: start; margin-top: 24px; } }
  .recent { list-style: none; padding: 0; margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0 24px; }
  .recent li { display: grid; gap: 4px; padding: 14px 0; border-top: 1px solid var(--line); }
  .recent a { text-decoration: none; font: 700 17px/1.3 var(--disp); }
  .recent a:hover { color: var(--a2); }
  .pillars { columns: 2; column-gap: 48px; margin-bottom: 16px; }
  .pillars div { break-inside: avoid; padding-bottom: 22px; }
  .pillars h3 { font-size: 19px; }
  .pillars p { color: var(--muted); font-size: 16px; }
  @media (max-width: 640px) { .pillars { columns: 1; } }
  .nums { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .nums b { font: 900 clamp(44px, 6vw, 88px)/.9 var(--disp); letter-spacing: -.05em; display: block; }
  .nums span { font: 500 15px/1.35 var(--disp); color: var(--muted); display: block; margin-top: 10px; }
  .nums small { grid-column: 1 / -1; color: var(--faint); font-size: 14px; }
  @media (max-width: 820px) { .nums { grid-template-columns: 1fr 1fr; } }
</style>
