---
import '@fontsource-variable/red-hat-display';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { SITE } from '../lib/data';
import Logo from '../components/Logo.astro';

interface Props {
  title: string; description: string; jsonld?: object | object[]; noindex?: boolean;
  crumbs?: [string, string][]; // [name, path] after Home; last item is the current page
  ogImage?: string; ogType?: string;
  search?: boolean; // include this page in the site search index (Pagefind)
}
const { title, description, jsonld, noindex, crumbs, ogImage, ogType = 'website', search = true } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), SITE).href.replace(/\/404\/$/, '/404');
const fullTitle = title === 'ADITEJUS' ? 'ADITEJUS: learn to build real AI' : `${title} | ADITEJUS`;
const desc = description.length > 160 ? description.slice(0, 157).replace(/\s+\S*$/, '') + '…' : description;
const image = new URL(ogImage || '/og.jpg', SITE).href;
const nav = [
  ['/paths/', 'Paths'], ['/courses/', 'Courses'], ['/roadmaps/', 'Roadmaps'], ['/tools/', 'Tools'], ['/academy/', 'Academy'],
  ['/insights/', 'Insights'],
];
const path = Astro.url.pathname;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'ADITEJUS', url: SITE, logo: `${SITE}/brand/icon-512.png`, sameAs: ['https://www.youtube.com/@aditejus'] };
const trail = crumbs ? [['Home', '/'] as [string, string], ...crumbs] : null;
const bc = trail && {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, SITE).href })),
};
const ld = [org, ...(bc ? [bc] : []), ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={desc}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0A1022" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#F8F6F0" media="(prefers-color-scheme: light)">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="sitemap" href="/sitemap.xml">
  <link rel="alternate" type="application/rss+xml" title="ADITEJUS Insights" href="/insights/rss.xml">
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="ADITEJUS">
  <meta property="og:locale" content="en_IN">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={image}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={desc}>
  <meta name="twitter:image" content={image}>
  <script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <nav class="top wrap" aria-label="Main">
      <Logo />
      <ul id="menu">
        {nav.map(([href, label]) => <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
      <form class="hs" action="/search/" method="get" role="search" aria-label="Site">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
        <label class="sr" for="hs-q">Search lessons, tools and courses</label>
        <input id="hs-q" type="search" name="q" placeholder="Search lessons, tools…" autocomplete="off" enterkeyhint="search">
        <kbd aria-hidden="true">/</kbd>
      </form>
      <a class="tt hs-m" href="/search/" aria-label="Search"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg></a>
      <button class="tt" id="tt" type="button" aria-label="Switch between light and dark theme" title="Light / dark"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg></button>
      <button class="mb" id="mb" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
    </nav>
  </header>
  <main id="main" data-pagefind-body={search && !noindex ? '' : undefined}>
    {trail && (
      <div class="wrap" data-pagefind-ignore><nav aria-label="Breadcrumb"><ol class="crumbs">
        {trail.map(([name, p], i) => <li>{i === trail.length - 1 ? <span aria-current="page">{name}</span> : <a href={p}>{name}</a>}</li>)}
      </ol></nav></div>
    )}
    <slot />
  </main>
  <footer>
    <div class="wrap fgrid">
      <div>
        <Logo size="sm" />
        <p class="faint" style="margin-top:12px;max-width:34ch">Learn to build real AI: agents, RAG, automation. Free to start on YouTube.</p>
      </div>
      <ul><li><a href="/paths/">Goal paths</a></li><li><a href="/courses/">Courses</a></li><li><a href="/courses/syllabus/">Full syllabus</a></li><li><a href="/roadmaps/">Roadmaps</a></li><li><a href="/tools/">Tools directory</a></li></ul>
      <ul><li><a href="/search/">Search</a></li><li><a href="/academy/">Academy</a></li><li><a href="/projects/">Projects</a></li><li><a href="/workshops/">Workshops</a></li><li><a href="/insights/">Insights</a></li><li><a href="/about/">About</a></li></ul>
      <ul><li><a href="https://www.youtube.com/@aditejus">YouTube</a></li><li><a href="/legal/privacy/">Privacy</a></li><li><a href="/legal/terms/">Terms</a></li><li><a href="/legal/ai-disclosure/">AI disclosure</a></li></ul>
    </div>
    <div class="wrap faint" style="margin-top:32px">This site sets no cookies and uses no trackers.</div>
  </footer>
  <script is:inline>
  (function(){
    var r=document.documentElement;
    document.getElementById('tt').onclick=function(){var c=r.dataset.theme||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');var n=c==='dark'?'light':'dark';r.dataset.theme=n;try{localStorage.setItem('theme',n)}catch(e){}};
    var mb=document.getElementById('mb'),m=document.getElementById('menu');
    mb.onclick=function(){var o=m.classList.toggle('open');mb.setAttribute('aria-expanded',o)};
    var q=document.getElementById('hs-q');
    document.addEventListener('keydown',function(e){if(e.key==='/'&&!/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)&&!e.ctrlKey&&!e.metaKey){var s=document.getElementById('sq')||q;if(s&&s.offsetParent){e.preventDefault();s.focus()}}});
  })();
  </script>
</body>
</html>
<style is:global>
  .site-head { position: sticky; top: 0; z-index: 50; background: var(--nav-bg); -webkit-backdrop-filter: saturate(160%) blur(14px); backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid var(--line); }
  .top { display: flex; align-items: center; gap: 20px; height: 64px; position: relative; }
  .top ul { display: flex; gap: 2px; list-style: none; padding: 0; margin: 0 0 0 auto; }
  .hs { position: relative; display: flex; align-items: center; }
  .hs svg { position: absolute; left: 11px; color: var(--faint); pointer-events: none; }
  .hs input { height: 36px; width: 210px; padding: 0 30px 0 32px; font-size: 14px; border-radius: 8px; box-shadow: none; background: color-mix(in srgb, var(--surface) 70%, transparent); transition: width .2s, border-color .15s, box-shadow .15s; }
  .hs input:focus { width: 250px; }
  .hs kbd { position: absolute; right: 9px; font: 500 11.5px var(--mono); color: var(--faint); border: 1px solid var(--line-2); border-radius: 4px; padding: 1px 5px; pointer-events: none; }
  .hs input:focus + kbd { display: none; }
  .hs-m { display: none !important; }
  @media (max-width: 1140px) { .hs input, .hs input:focus { width: 170px; } }
  .top ul a { display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--muted); font: 500 14.5px var(--sans); transition: color .15s, background .15s; }
  .top ul a:hover { color: var(--text); background: color-mix(in srgb, var(--cell) 60%, transparent); }
  .top ul a[aria-current] { color: var(--text); background: color-mix(in srgb, var(--cell) 80%, transparent); }
  .tt, .mb { font: 500 13.5px var(--sans); height: 36px; padding: 0 12px; display: inline-grid; place-items: center; border-radius: 8px; border: 1px solid var(--line-2); background: transparent; color: var(--muted); cursor: pointer; transition: color .15s, border-color .15s; }
  .tt:hover, .mb:hover { color: var(--text); border-color: var(--accent); }
  .tt { width: 36px; padding: 0; }
  .mb { display: none; }
  @media (max-width: 900px) {
    .top { gap: 12px; }
    .hs { display: none; }
    .hs-m { display: inline-grid !important; margin-left: auto; }
    .mb { display: inline-grid; }
    .top ul { display: none; position: absolute; top: 64px; left: var(--gut); right: var(--gut); flex-direction: column; gap: 2px; background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r); padding: 8px; box-shadow: var(--shadow-3); }
    .top ul.open { display: flex; }
    .top ul a { padding: 12px; }
  }
  footer { border-top: 1px solid var(--line); padding: 56px 0 56px; margin-top: var(--sec); background: var(--bg-2); }
  .fgrid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  footer ul { list-style: none; padding: 0; display: grid; gap: 10px; font: 400 14.5px var(--sans); }
  footer ul a { color: var(--muted); text-decoration: none; }
  footer ul a:hover { color: var(--text); }
  @media (max-width: 760px) { .fgrid { grid-template-columns: 1fr 1fr; } .fgrid > div:first-child { grid-column: 1 / -1; } }
</style>
