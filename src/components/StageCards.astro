---
// Beginner / Builder / Pro: each stage lists the tracks it draws from (derived from the roadmap steps).
import { roadmaps } from '../lib/roadmaps';
import { trackById } from '../lib/data';
const stages = roadmaps.map((r) => {
  const ids: string[] = [];
  for (const s of r.steps) if (!ids.includes(s.trackId)) ids.push(s.trackId);
  return { ...r, tracks: ids.map((id) => trackById.get(id)!), lessons: r.steps.reduce((a, s) => a + s.lessons.length, 0) };
});
---
<div class="stages">
  {stages.map((s, i) => (
    <article class="stage">
      <div class="top"><b>{i + 1}</b><span class="faint">{s.steps.length} steps, {s.lessons} lessons</span></div>
      <h3>{s.title}</h3>
      <p class="muted">{s.goal}</p>
      <ul>{s.tracks.map((t) => <li><a href={`/courses/syllabus/#${t.id}`}><span class="n">{t.n}</span>{t.title}</a></li>)}</ul>
      <a class="btn sm" href={`/roadmaps/#${s.id}`}>{s.title} checklist</a>
    </article>
  ))}
</div>
<style>
  .stages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 2px solid var(--text); }
  .stage { padding: 24px 28px 32px 0; display: flex; flex-direction: column; gap: 10px; }
  .stage + .stage { padding-left: 28px; border-left: 1px solid var(--line); }
  .top { display: flex; justify-content: space-between; align-items: baseline; }
  .top b { font: 900 56px/1 var(--disp); color: var(--faint); letter-spacing: -.04em; }
  .stage h3 { font: 900 32px/1 var(--disp); letter-spacing: -.03em; }
  .stage ul { list-style: none; padding: 0; margin: 8px 0 12px; border-top: 1px solid var(--line); }
  .stage li a { display: flex; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); text-decoration: none; font: 500 15px/1.35 var(--disp); }
  .stage li a:hover { color: var(--a2); }
  .stage .n { color: var(--faint); min-width: 20px; }
  .stage .btn { align-self: flex-start; margin-top: auto; }
  @media (max-width: 900px) { .stages { grid-template-columns: 1fr; } .stage, .stage + .stage { padding: 24px 0 28px; border-left: 0; border-bottom: 1px solid var(--line); } }
</style>
