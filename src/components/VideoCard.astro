---
// "New this week": a visual preview of the latest live lesson. Uses the self-hosted YouTube
// thumbnail when present (public/thumbs), otherwise a drawn poster with the lesson's track map.
import { type Lesson, ytUrl, thumbFor, levelLabel, trackById, udemyFor, lessonPath, fmtDate, lessons } from '../lib/data';
const { l } = Astro.props as { l: Lesson };
const thumb = thumbFor(l.youtubeId);
const track = trackById.get(l.track)!;
const udemy = udemyFor(l);
const trackLessons = lessons.filter((x) => x.track === l.track);
---
<div class="vc">
  <a class="pv" href={ytUrl(l.youtubeId!)} aria-label={`Watch ${l.title} free on YouTube`}>
    {thumb
      ? <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async">
      : (
        <div class="poster" aria-hidden="true">
          <span class="pt">{l.title}</span>
          <span class="mini">{trackLessons.map((x) => <i class={x.id === l.id ? 'me' : x.live ? 'lv' : ''}></i>)}</span>
        </div>
      )}
    <span class="play" aria-hidden="true"></span>
    <span class="dur">{l.minutes} min</span>
  </a>
  <div class="info">
    <p class="faint">Published {fmtDate(l.publishAt!)} in {track.title}</p>
    <h3><a href={lessonPath(l.id)}>{l.title}</a></h3>
    <p class="out">{l.outcome}.</p>
    <div class="tags">
      <span class="badge">{levelLabel(l.level)}</span>
      {l.tools.map((t) => <span class="badge">{t.name}</span>)}
    </div>
    <div class="ctas">
      <a class="btn fill" href={ytUrl(l.youtubeId!)}>Watch free on YouTube</a>
      {udemy ? <a class="btn" href={udemy.href}>Enroll on Udemy</a> : <span class="btn" aria-disabled="true">Udemy certificate: coming soon</span>}
    </div>
  </div>
</div>
<style>
  .vc { display: grid; grid-template-columns: 7fr 5fr; gap: 40px; align-items: center; }
  .pv { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: #0A1022; border: 1px solid var(--line); box-shadow: var(--shadow-3); }
  .pv img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .pv:hover img { transform: scale(1.02); }
  .poster { position: absolute; inset: 0; padding: clamp(20px, 3vw, 32px); display: flex; flex-direction: column; justify-content: space-between; color: #F4EFE4;
    background: radial-gradient(90% 90% at 88% 6%, rgba(230, 185, 84, .42), transparent 60%), radial-gradient(80% 80% at 0% 100%, rgba(120, 140, 220, .18), transparent 60%), #0A1022; }
  .poster::after { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(214,196,150,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(214,196,150,.06) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none; }
  .pt { font: 800 clamp(22px, 2.8vw, 38px)/1.04 var(--disp); letter-spacing: -.03em; max-width: 15ch; margin-top: 28px; position: relative; z-index: 1; }
  .mini { display: flex; flex-wrap: wrap; gap: 4px; max-width: 58%; position: relative; z-index: 1; }
  .mini i { width: 10px; height: 10px; border-radius: 2.5px; background: rgba(238, 241, 248, .16); }
  .mini i.lv { background: #EBC56A; }
  .mini i.me { background: #FFF4D6; box-shadow: 0 0 0 1.5px #EBC56A, 0 0 14px #EBC56A; }
  .play { position: absolute; right: 24px; bottom: 24px; z-index: 2; width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center;
    background: #F4EFE4; box-shadow: 0 10px 30px -6px rgba(0,0,0,.6), 0 0 0 8px rgba(238,241,248,.12); transition: transform .2s, box-shadow .2s; }
  .play::after { content: ""; border-left: 18px solid #0A1022; border-top: 11px solid transparent; border-bottom: 11px solid transparent; margin-left: 5px; }
  .pv:hover .play { transform: scale(1.06); box-shadow: 0 10px 30px -6px rgba(0,0,0,.6), 0 0 0 10px rgba(235,197,106,.3); }
  .dur { position: absolute; left: 16px; top: 16px; z-index: 2; font: 600 12px var(--sans); background: rgba(9, 13, 25, .7); color: #F4EFE4; padding: 4px 8px; border-radius: 6px; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .info h3 { font: 750 clamp(24px, 2.4vw, 32px)/1.1 var(--disp); letter-spacing: -.025em; margin: 10px 0 10px; }
  .info h3 a { text-decoration: none; }
  .info h3 a:hover { color: var(--accent); }
  .out { max-width: 42ch; color: var(--muted); }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 16px; }
  @media (max-width: 860px) { .vc { grid-template-columns: 1fr; gap: 24px; } .play { width: 52px; height: 52px; right: 16px; bottom: 16px; } }
</style>
