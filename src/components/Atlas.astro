---
// Hero panel: every lesson in the syllabus as one cell (live lessons bright), plus a route-planner
// console that types a scripted route to "chat with my files" and lights that path on the map.
import { tracks, lessons, lessonById, lessonPath, stats } from '../lib/data';
const ROUTE = ['f-what-is-llm', 'f-tokens-context', 'f-hallucination', 'p-prompting-basics', 'p-better-prompts', 'py-install',
  'llm-ollama', 'rag-one-picture', 'rag-chunks-embeddings', 'rag-tutorial-python'].filter((id) => lessonById.has(id));
const routeTitles = ROUTE.map((id) => lessonById.get(id)!.title);
let liveIdx = 0;
const short = (s: string) => s.replace(/\s*\(.*?\)/g, '').replace(/:.*$/, '').replace(/ and .*$/, '').replace(/, From Zero/, '').replace(/^Working With /, '');
---
<div class="atlas panel" role="group" aria-labelledby="atlas-h">
  <div class="a-head">
    <h2 id="atlas-h" class="a-title">The syllabus, {stats.lessons} lessons</h2>
    <div class="legend" aria-hidden="true"><span><i class="k live"></i>Live</span><span><i class="k"></i>Coming soon</span><span><i class="k path"></i>Your route</span></div>
  </div>
  <div class="grid">
    {tracks.map((t) => (
      <div class="tr">
        <a class="nm" href={`/courses/syllabus/#${t.id}`} title={t.title}><span class="no">{String(t.n).padStart(2, '0')}</span><span class="tn">{short(t.title)}</span></a>
        <div class="cells" aria-hidden="true">
          {lessons.filter((l) => l.track === t.id).map((l) => (
            <a class={`c ${l.level[0]}${l.live ? ' live' : ''}`} href={lessonPath(l.id)} tabindex="-1" data-id={l.id}
               style={l.live ? `--i:${liveIdx++}` : undefined} title={`${l.title} (${l.live ? 'live' : 'coming soon'})`}></a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <p class="weekly">Lighting up every week. Live lessons are bright.</p>
  <div class="console" aria-hidden="true">
    <div class="c-bar"><span class="dot"></span>route planner<span class="c-note">scripted demo</span></div>
    <div class="c-lines" id="log" data-route={JSON.stringify(ROUTE)} data-titles={JSON.stringify(routeTitles)} data-total={stats.lessons}></div>
  </div>
</div>
<script is:inline>
(function(){
  var log=document.getElementById('log');if(!log)return;
  var route=JSON.parse(log.dataset.route),titles=JSON.parse(log.dataset.titles),total=log.dataset.total;
  var L=[['q','goal ','"Build a chatbot that answers from my files"'],['f','search_syllabus','(goal, level="beginner")'],['r','',total+' lessons scanned, '+route.length+' picked'],['f','order_by_prerequisites','()']]
    .concat(titles.map(function(t){return ['r','+ ',t]})).concat([['f','save_checklist','("my-route")  done']]);
  var cells=route.map(function(id){return document.querySelector('.atlas .c[data-id="'+id+'"]')});
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  function mark(n){cells.forEach(function(c,i){if(!c)return;c.classList.toggle('path',i<n-4);c.classList.toggle('cur',i===n-5&&!reduce)})}
  function line(k){var d=document.createElement('div');d.className='ln';var a=document.createElement('span');a.className=k[0];d.appendChild(a);var b=document.createElement('span');d.appendChild(b);log.appendChild(d);while(log.children.length>4)log.removeChild(log.firstChild);return [a,b]}
  if(reduce){L.slice(-4).forEach(function(k){var x=line(k);x[0].textContent=k[1];x[1].textContent=k[2]});mark(L.length);return}
  var n=0;
  function next(){
    if(n>=L.length){setTimeout(function(){cells.forEach(function(c){c&&c.classList.remove('path','cur')});log.innerHTML='';n=0;setTimeout(next,700)},3800);return}
    var k=L[n],x=line(k),s=k[1]+k[2],i=0;
    (function type(){i++;var t=s.slice(0,i);x[0].textContent=t.slice(0,k[1].length);x[1].textContent=t.slice(k[1].length);if(i<s.length)setTimeout(type,14);else{n++;mark(n);setTimeout(next,n<5?420:300)}})();
  }
  setTimeout(next,900);
})();
</script>
<style>
  .atlas { position: relative; padding: 20px 22px 0; overflow: hidden; isolation: isolate; }
  .atlas::before { content: ""; position: absolute; inset: -40% -20% auto auto; width: 70%; height: 90%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, var(--glow), transparent); }
  .a-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
  .a-title { font: 600 14px var(--sans); letter-spacing: .01em; color: var(--text); }
  .legend { display: flex; gap: 14px; font: 500 12.5px var(--sans); color: var(--muted); }
  .k { display: inline-block; width: 9px; height: 9px; border-radius: 2.5px; margin-right: 6px; vertical-align: -.5px; background: var(--cell); }
  .k.live { background: var(--live); box-shadow: 0 0 6px var(--glow); } .k.path { background: var(--route); outline: 1px solid var(--live); }
  .grid { display: grid; gap: 5px; }
  .tr { display: grid; grid-template-columns: 148px 1fr; gap: 12px; align-items: start; }
  .nm { display: flex; gap: 8px; font: 500 12.5px/12px var(--sans); color: var(--muted); text-decoration: none; white-space: nowrap; overflow: hidden; padding-top: 1px; }
  .nm .no { font-family: var(--mono); color: var(--faint); font-size: 11.5px; }
  .nm .tn { overflow: hidden; text-overflow: ellipsis; }
  .nm:hover { color: var(--text); }
  .cells { display: flex; flex-wrap: wrap; gap: 3px; }
  .c { width: 11px; height: 11px; border-radius: 2.5px; background: var(--cell); display: block; transition: background .3s, box-shadow .3s, transform .3s; }
  .c.i { opacity: .85; } .c.a { opacity: .7; }
  .c.live { background: var(--live); opacity: 1; box-shadow: 0 0 10px color-mix(in srgb, var(--live) 45%, transparent); animation: lightup .9s cubic-bezier(.2,.7,.2,1) backwards; animation-delay: calc(var(--i, 0) * 110ms + 250ms); }
  .c.path { background: var(--route); opacity: 1; box-shadow: 0 0 0 1.5px var(--live), 0 0 14px color-mix(in srgb, var(--live) 70%, transparent); }
  .c.cur { background: var(--route); transform: scale(1.3); box-shadow: 0 0 0 2px var(--live), 0 0 20px var(--live); }
  @keyframes lightup { 0% { background: var(--cell); box-shadow: none; } 55% { background: var(--route); box-shadow: 0 0 18px var(--live); } 100% { background: var(--live); } }
  .weekly { font: 500 13px var(--sans); color: var(--muted); margin: 16px 0 16px 160px; }
  .console { margin: 0 -22px; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 55%, transparent); padding: 10px 22px 14px; font: 400 12.5px/1.75 var(--mono); }
  .c-bar { display: flex; align-items: center; gap: 8px; color: var(--faint); font-size: 11.5px; letter-spacing: .03em; margin-bottom: 4px; }
  .c-bar .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live); box-shadow: 0 0 8px var(--live); }
  .c-note { margin-left: auto; }
  .c-lines { height: calc(4 * 1.75em); overflow: hidden; color: var(--text); }
  .c-lines :global(.ln) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .c-lines :global(.f) { color: var(--accent); } .c-lines :global(.q) { color: var(--faint); } .c-lines :global(.r) { color: var(--muted); }
  @media (max-width: 640px) {
    .atlas { padding: 16px 16px 0; }
    .tr { grid-template-columns: 22px 1fr; gap: 8px; }
    .nm .tn { display: none; }
    .c { width: 9px; height: 9px; border-radius: 2px; }
    .weekly { margin-left: 30px; }
    .console { margin: 0 -16px; padding: 10px 16px 12px; }
    .legend { gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .c.live { animation: none; } }
</style>
