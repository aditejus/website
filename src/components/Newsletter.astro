// Placeholder: no backend yet. TODO(creator): pick the email tool (free tier first), then point the form at it.
---
<section class="blk"><div class="wrap news">
  <div><h2>Friday, in your inbox.</h2><p class="muted" style="margin-top:12px">Plus whatever went live that week. Unsubscribe in one click.</p></div>
  <form class="nl" action="#" method="post" novalidate>
    <label class="sr" for="nl-email">Email address</label>
    <input id="nl-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required>
    <button class="btn fill" type="submit">Join the newsletter</button>
    <p class="nl-msg faint" role="status" hidden>Sign-up opens soon. Nothing was sent or stored.</p>
  </form>
</div></section>
<script is:inline>
document.querySelectorAll('form.nl').forEach(function(f){f.addEventListener('submit',function(e){e.preventDefault();f.querySelector('.nl-msg').hidden=false})});
</script>
<style>
  .news { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  form { display: flex; gap: 10px; flex-wrap: wrap; }
  input { flex: 1 1 220px; }
  .nl-msg { flex-basis: 100%; }
  @media (max-width: 860px) { .news { grid-template-columns: 1fr; gap: 24px; } }
</style>
